year1=1980
year2=2021
yyyy=year1
yyyy2=year2+1
*
'set gxout fwrite'
'set fwrite Had-ano-remglo.d'
*'open /discover/nobackup/ylim/Data/SST/OI-19822022-remglo.ctl'
'open /discover/nobackup/ylim/Data/SST/Had-18702021-remglo.ctl'
'set x 1 360'
'set y 1 180'
'set z 1'
'set t 1'
'define aa1=ave(sst,time=01jan'year1',time=01jan'year2',12)'
'define bb1=ave(sst,time=01feb'year1',time=01feb'year2',12)'
'define cc1=ave(sst,time=01mar'year1',time=01mar'year2',12)'
'define dd1=ave(sst,time=01apr'year1',time=01apr'year2',12)'
'define ee1=ave(sst,time=01may'year1',time=01may'year2',12)'
'define ff1=ave(sst,time=01jun'year1',time=01jun'year2',12)'
'define gg1=ave(sst,time=01jul'year1',time=01jul'year2',12)'
'define hh1=ave(sst,time=01aug'year1',time=01aug'year2',12)'
'define ii1=ave(sst,time=01sep'year1',time=01sep'year2',12)'
'define jj1=ave(sst,time=01oct'year1',time=01oct'year2',12)'
'define kk1=ave(sst,time=01nov'year1',time=01nov'year2',12)'
'define ll1=ave(sst,time=01dec'year1',time=01dec'year2',12)'
while (yyyy < yyyy2)
height=1
*'open /discover/nobackup/ylim/Data/SST/OI-19822022-remglo.ctl'
'open /discover/nobackup/ylim/Data/SST/Had-18702021-remglo.ctl'
'set dfile 2'
'set x 1 360'
'set y 1 180'
'set z 'height''
'set t 1'
'define aa=sst(time=01jan'yyyy')'
'define bb=sst(time=01feb'yyyy')'
'define cc=sst(time=01mar'yyyy')'
'define dd=sst(time=01apr'yyyy')'
'define ee=sst(time=01may'yyyy')'
'define ff=sst(time=01jun'yyyy')'
'define gg=sst(time=01jul'yyyy')'
'define hh=sst(time=01aug'yyyy')'
'define ii=sst(time=01sep'yyyy')'
'define jj=sst(time=01oct'yyyy')'
'define kk=sst(time=01nov'yyyy')'
'define ll=sst(time=01dec'yyyy')'
'd aa-aa1'
'd bb-bb1'
'd cc-cc1'
'd dd-dd1'
'd ee-ee1'
'd ff-ff1'
'd gg-gg1'
'd hh-hh1'
'd ii-ii1'
'd jj-jj1'
'd kk-kk1'
'd ll-ll1'
'close 2'
say yyyy
yyyy=yyyy+1
endwhile
'close 1'
quit
